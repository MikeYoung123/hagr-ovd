# Copy to configs/paths.env and edit for your machine.
export DATA_ROOT="$(pwd)/data"
export BASE_DATASET="$DATA_ROOT/bridge_grounding"
export TRI_DATASET="$DATA_ROOT/bridge_grounding_tri_granular"
export PROPAGATED_DATASET="$DATA_ROOT/bridge_temporal_propagated"
export TEMPORAL_DATASET="$DATA_ROOT/bridge_grounding_temporal_joint"
export CHECKPOINT_ROOT="$(pwd)/checkpoints"
